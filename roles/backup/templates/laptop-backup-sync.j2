#!/usr/bin/env bash
# Von Ansible generiert (roles/backup) - nicht von Hand pflegen.
#
# Repliziert per syncoid auf den Home-Server, aber NUR wenn
# roles/vpn_killswitch (ueber /run/vpn-killswitch-state) bestaetigt, dass
# der Laptop wirklich im Heimnetz ist - kein Sync ueber mobile Daten oder
# fremdes WLAN. "state != HOME" ist unterwegs der Normalfall, deshalb
# exit 0 statt Fehler (kein Alarm bei jedem Timer-Tick unterwegs).
set -euo pipefail

STATE_FILE="/run/vpn-killswitch-state"
SSH_KEY="/etc/backup-ssh/laptop_backup"
KNOWN_HOSTS="/etc/backup-ssh/known_hosts"
REMOTE_USER="{{ laptop_backup_remote_user }}"
REMOTE_HOST="{{ vault_laptop_backup_remote_host }}"
REMOTE_BASE="{{ laptop_backup_remote_base }}"

log() { logger -t laptop-backup-sync "$*"; }

state="$(cat "$STATE_FILE" 2>/dev/null || echo unknown)"
if [[ "$state" != "HOME" ]]; then
    log "skip (state=$state, nicht im Heimnetz)"
    exit 0
fi

sync_dataset() {
    local dataset="$1" remote_path="$2"
    syncoid --no-privilege-elevation --no-sync-snap \
        --sshkey "$SSH_KEY" \
        --sshoption "UserKnownHostsFile=$KNOWN_HOSTS" \
        --sshoption "IdentitiesOnly=yes" \
        "$dataset" "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_BASE}/${remote_path}"
}

log "Sync startet (Heimnetz bestaetigt)"
sync_dataset "{{ root_dataset }}" root
sync_dataset "{{ home_dataset }}" home
log "Sync abgeschlossen"
