#!/bin/bash
# Waechter: Der Notzugangs-Key darf NIE im ssh-agent liegen (Regel User, 2026-10-03).
# Geht alle Agent-Sockets durch und entfernt den Key, falls er doch geladen wurde.
# Aufruf ohne Argument: ~/.ssh/notzugang.pub; optional anderer Pubkey (fuer Tests).
PUB="${1:-$HOME/.ssh/notzugang.pub}"
[ -r "$PUB" ] || exit 0
KEY=$(cut -d' ' -f2 "$PUB")
for sock in "$HOME"/.ssh/agent/s.* "$SSH_AUTH_SOCK"; do
    [ -S "$sock" ] || continue
    if SSH_AUTH_SOCK="$sock" ssh-add -L 2>/dev/null | grep -qF "$KEY"; then
        SSH_AUTH_SOCK="$sock" ssh-add -d "$PUB" >/dev/null 2>&1
        logger -t notzugang-wache "Notzugangs-Key aus ssh-agent entfernt ($sock)"
        notify-send -u critical "Notzugangs-Key entfernt" "Der Key war im ssh-agent ($sock) und wurde entfernt. Er darf nie in den Agent." 2>/dev/null
    fi
done
exit 0
