#!/bin/bash
# Emergency override: disables the VPN kill-switch until the next reboot.
set -e
if [ "$(id -u)" -ne 0 ]; then
    echo "Bitte mit sudo ausfuehren." >&2
    exit 1
fi
touch /run/vpn-killswitch-override
logger -t vpn-killswitch "manual override ENABLED (open until reboot)"
/usr/local/sbin/vpn-killswitch-apply
echo "Kill-Switch deaktiviert bis zum naechsten Neustart. (sudo vpn-killswitch-enable zum Wiederaktivieren)"
